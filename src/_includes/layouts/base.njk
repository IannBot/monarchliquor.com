<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{{ ogType }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="{{ twitterCard }}">
  <meta name="twitter:title" content="{{ twitterTitle }}">
  <meta name="twitter:description" content="{{ twitterDescription }}">
{%- if twitterCard != "summary" %}
  <meta name="twitter:image" content="{{ ogImage }}">
{%- endif %}

  <!-- Favicons -->
  <link rel="icon" href="/images/favicon.ico" sizes="48x48">
  <link rel="icon" href="/images/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="{{ site.themeColor }}">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
{%- if preload %}

  <!-- Hero preload (media queries match .hero CSS) -->
{%- for p in preload %}
  <link rel="preload" as="image" href="{{ p.href }}" type="image/webp" media="{{ p.media }}">
{%- endfor %}
{%- endif %}
{%- if jsonld %}

  <!-- Structured Data -->
  <script type="application/ld+json">
  {{ jsonld | jsonld | safe }}
  </script>
{%- endif %}

  <script src="/js/main.js" defer></script>
  <script type="module" src="/js/hours.js"></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "partials/announcement.njk" %}

  {% include "partials/header.njk" %}

  {% include "partials/store-strip.njk" %}

  {% include "partials/social-sidebar.njk" %}

  {% include "partials/mobile-menu.njk" %}

  <main id="main">
{{ content | safe }}
  </main>

  <script type="application/json" id="business-hours">{{ { hours: business.hours, timezone: business.timezone } | dump | safe }}</script>

  {% include "partials/footer.njk" %}

</body>
</html>

  <!-- Store strip: one shared status (both stores keep the same hours) plus both addresses. -->
  <div class="store-strip" aria-label="Store hours and locations">
    <div class="store-strip__status">{% set statusStore = null %}{% include "partials/hours-status.njk" %}</div>
    <div class="store-strip__stores">
{%- for store in business.stores %}
      <a class="store-strip__store" href="{{ store.url }}">
        <span class="store-strip__name">{{ store.shortName }}</span>
        <span class="store-strip__address">{{ store.address.streetShort }}</span>
      </a>
{%- endfor %}
    </div>
  </div>

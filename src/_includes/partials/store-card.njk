{#- One store as a card. Set `store` before including; set `cardFull = true`
    for the email + hours table + map variant (about, contact). -#}
{%- set cardPhoto = photos[store.photos.hero] %}
<div class="store-card{% if cardFull %} store-card--full{% endif %}{% if cardPhoto.base %} store-card--photo{% endif %} reveal" id="store-{{ store.id }}">
{%- if cardPhoto.base %}
  <a class="store-card__photo" href="{{ store.url }}" tabindex="-1" aria-hidden="true">
    <picture>
      <source type="image/webp" srcset="{{ cardPhoto.base }}-768.webp 768w, {{ cardPhoto.base }}-1280.webp 1280w" sizes="(max-width: 768px) 92vw, 540px">
      <img src="{{ cardPhoto.base }}-768.jpg" srcset="{{ cardPhoto.base }}-768.jpg 768w, {{ cardPhoto.base }}-1280.jpg 1280w" sizes="(max-width: 768px) 92vw, 540px" width="768" height="432" alt="{{ cardPhoto.alt }}" loading="lazy" decoding="async">
    </picture>
  </a>
{%- endif %}
  <div class="store-card__head">
    <h3><a href="{{ store.url }}">{{ store.shortName }}</a></h3>
    <p class="store-card__tagline">{{ store.tagline }}</p>
  </div>
  <p class="store-card__status">{% set statusStore = store %}{% include "partials/hours-status.njk" %}</p>
  <address class="store-card__address">
    <svg class="icon icon--map-pin" aria-hidden="true" focusable="false"><use href="#i-map-pin"/></svg>
    <a href="{{ store.directionsUrl }}" target="_blank" rel="noopener noreferrer">{{ store.address.street }}<br>{{ store.address.locality }}, {{ store.address.region }} {{ store.address.postalCode }}</a>
  </address>
  <p class="store-card__line"><svg class="icon icon--phone" aria-hidden="true" focusable="false"><use href="#i-phone"/></svg> <a href="{{ store.phone.href }}">{{ store.phone.display }}</a></p>
{%- if cardFull %}
  <p class="store-card__line"><svg class="icon icon--mail" aria-hidden="true" focusable="false"><use href="#i-mail"/></svg> <a href="mailto:{{ store.email }}">{{ store.email }}</a></p>
  {% include "partials/hours-table.njk" %}
  <p class="store-card__note">{{ business.hours.holidayNote }}</p>
{%- else %}
  <p class="store-card__line"><svg class="icon icon--clock" aria-hidden="true" focusable="false"><use href="#i-clock"/></svg> {{ hoursLib.weeklySummary(business.hours) | join(" · ") }}</p>
{%- endif %}
  <div class="store-card__actions">
    <a href="{{ site.bottlecapps.home }}" target="_blank" rel="noopener" class="btn btn--primary shop-link" data-cta="store-card-{{ store.id }}">Order Delivery</a>
    <a href="{{ store.directionsUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Directions</a>
    <a href="{{ store.url }}" class="btn btn--ghost">Store details</a>
  </div>
{%- if cardFull %}
  <iframe
    src="{{ store.mapEmbedUrl }}"
    width="100%" height="250" style="border:0;border-radius:8px" allowfullscreen loading="lazy"
    title="{{ store.name }} map"></iframe>
{%- endif %}
</div>
